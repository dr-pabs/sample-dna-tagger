<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation (required by Python) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (bundled dynamic libraries) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Disable library validation (bundled frameworks) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access for LLM API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read/write access to user-selected folders (sample libraries) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
